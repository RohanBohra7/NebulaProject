# ====================================================================
# NEBULA: Intelligent Astronomical Data Platform Environment Variables
# ====================================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./nebula.db

# Simulation Engine
DEFAULT_INTEGRATOR=ias15

# AI Provider Configuration (Optional - Provider Agnostic)
# If no API key is specified, NEBULA operates offline using its 
# deterministic empirical astronomical knowledge engine.
DEFAULT_AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration
VITE_API_URL=/api/v1
