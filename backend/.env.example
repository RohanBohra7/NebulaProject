# NEBULA Environment Configuration Template
# Copy this file to .env and configure values as needed.
# Note: NEBULA functions completely offline without any API keys using its built-in
# deterministic astronomical AI grounding engine.

# Platform Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration (defaults to local SQLite database)
DATABASE_URL=sqlite:///./nebula.db

# Optional AI Provider API Keys
# If not provided, NEBULA uses its verified local deterministic knowledge and tools engine.
DEFAULT_AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# N-body Simulation Configuration
DEFAULT_INTEGRATOR=ias15
